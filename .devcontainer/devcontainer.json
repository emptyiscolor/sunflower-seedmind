{
	"name": "SeedGen2",
	"image": "mcr.microsoft.com/devcontainers/python:3.12",
    "features": {
        "ghcr.io/mikaello/devcontainer-features/modern-shell-utils:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/rust:1": {},
		"ghcr.io/devcontainers-community/features/llvm:3": {},
		"ghcr.io/devcontainers/features/go:1": {},
		"ghcr.io/devcontainers-contrib/features/protoc:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.black-formatter",
				"ms-toolsai.jupyter",
				"llvm-vs-code-extensions.vscode-clangd",
				"zxh404.vscode-proto3"
			]
		}
	},
	"postCreateCommand": "pip install -r requirements.txt && pip install protobuf grpcio-tools && go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest"
}
